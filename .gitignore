# The active runtime checkout is an independent repository with its own commits.
/autorig_tools/

# Python
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
.venv/
venv/

# Maya
.mayaSwatches/
incrementalSave/
*.ma.bak
*.mb.bak
*.swatches

# Autorig build cache (regenerated on CREATE RIG)
maya_tools/cache/*.cache

# Local agent config (not this repo's .cursor/rules)
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.iml

# Regenerable packages, experiments and validation output.
# Working rigs intended for another PC belong in assets/<character>/scenes/.
/maya_tools/assets/*/packages/
/maya_tools/assets/*/experiments/
/maya_tools/assets/*/validation/
/maya_tools/assets/*/picker/validation/
/maya_tools/validation/
**/validation_report.json

# Local environments, test output and credentials
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
*.tmp
*.bak
